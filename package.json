{
  "name": "dsh-turbo",
  "version": "0.2.3",
  "type": "module",
  "description": "DSH OVERDRIVE — native session-scoped Fast/Max execution gears for DeepSeek Harness (package id: dsh-turbo).",
  "license": "MIT",
  "author": "burning-frappuccino",
  "homepage": "https://github.com/burning-frappuccino/dsh-turbo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/burning-frappuccino/dsh-turbo.git"
  },
  "bugs": {
    "url": "https://github.com/burning-frappuccino/dsh-turbo/issues"
  },
  "packageManager": "pnpm@12.4.1",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "latency",
    "turbo"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.js.map",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "tested"
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "bench": "node scripts/benchmark.mjs",
    "check:issues": "node scripts/check-issues.mjs --markdown audit/ISSUES.md",
    "check:issues:strict": "node scripts/check-issues.mjs --fail-on high"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
